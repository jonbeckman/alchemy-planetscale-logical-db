{
  "name": "alchemy-planetscale-logical-db",
  "version": "1.0.3",
  "description": "Alchemy v2 resource for managing logical PostgreSQL databases inside PlanetScale Postgres clusters.",
  "bugs": {
    "url": "https://github.com/jonbeckman/alchemy-planetscale-logical-db/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbeckman/alchemy-planetscale-logical-db.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "nub run typecheck && nub run lint && nub run format && nub run build && nub run --cwd example typecheck",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:fix:max": "oxlint --fix --fix-suggestions --fix-dangerously",
    "prepublishOnly": "nub run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@mpsuesser/oxlint-plugin-effect": "0.2.2",
    "@oxlint/plugins": "1.66.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.6",
    "alchemy": "2.0.0-beta.63",
    "effect": "4.0.0-beta.97",
    "oxfmt": "^0.48.0",
    "oxlint": "1.66.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.63",
    "effect": "4.0.0-beta.97"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.4.11",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "nub@0.4.11",
  "workspaces": [
    "example",
    "packages/*"
  ],
  "allowBuilds": {
    "esbuild": true,
    "msgpackr-extract": true,
    "workerd": true
  }
}
