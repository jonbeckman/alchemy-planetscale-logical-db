{
  "name": "alchemy-planetscale-logical-db",
  "version": "2.2.0",
  "description": "Alchemy v2 resource for managing logical PostgreSQL databases inside PlanetScale Postgres clusters.",
  "bugs": {
    "url": "https://github.com/jonbeckman/alchemy-planetscale-logical-db/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbeckman/alchemy-planetscale-logical-db.git"
  },
  "workspaces": [
    "example"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "nub run typecheck && nub run lint && nub run format && nub run test && nub run build && nub run --cwd example typecheck",
    "effect:diagnostics": "effect-tsrs diagnostics --project tsconfig.json --lspconfig '{}'",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:fix:max": "oxlint --fix --fix-suggestions --fix-dangerously",
    "prepublishOnly": "nub run build",
    "tegami": "tsx scripts/tegami.mts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsrs --noEmit && tsrs -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@alchemy.run/planetscale": "2.0.0-beta.84",
    "@effect/platform-node": "4.1.2",
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.15.6",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.1.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-solzero": "0.1.0",
    "tegami": "1.5.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@alchemy.run/planetscale": ">=2.0.0-beta.84",
    "alchemy": ">=2.0.0-beta.81",
    "effect": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.6",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "esbuild": true,
    "msgpackr-extract": true,
    "workerd": true
  }
}
